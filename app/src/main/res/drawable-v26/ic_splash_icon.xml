<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ Splash 自适应图标（2026-08-12 T5 整改）：
     背景色与 splash 窗口背景同源（lide_surface_background，亮/暗各自解析），
     同色融合后仅图形可见；前景 = 原宿主图标图形居中缩至安全区
     （66/108 dp 内，图形直径 ≈ 58% 画布，圆形遮罩下完整无裁切）。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lide_surface_background" />
    <foreground android:drawable="@drawable/ic_splash_foreground" />
</adaptive-icon>
