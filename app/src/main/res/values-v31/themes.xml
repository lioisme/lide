<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ Splash Screen（2026-08-12 T-2 整改，浅色态）：
         背景 = 宿主浅色 surface（与 Theme.kt BG_LIGHT 同源），图标 = 宿主自带图标。
         同名 style 按配置限定覆盖，此处必须完整声明全部 item。 -->
    <style name="Theme.Lide" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/lide_surface_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/icon</item>
    </style>
</resources>