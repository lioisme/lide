{
  "name": "Solarized Dual (Dark)",
  "tokenColors": [
    { "settings": { "foreground": "#93A1A1" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "fontStyle": "italic", "foreground": "#84949C" } },
    { "name": "Comments: Preprocessor", "scope": "comment.block.preprocessor", "settings": { "fontStyle": "", "foreground": "#84949C" } },
    { "name": "Comments: Documentation", "scope": ["comment.documentation", "comment.block.documentation"], "settings": { "foreground": "#809098" } },
    { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "#E9765C" } },
    { "name": "Invalid - Illegal", "scope": "invalid.illegal", "settings": { "foreground": "#F08A70" } },
    { "name": "Operators", "scope": "keyword.operator", "settings": { "foreground": "#93A1A1" } },
    { "name": "Keywords", "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#859900" } },
    { "name": "Types", "scope": ["storage.type", "support.type"], "settings": { "foreground": "#948ED2" } },
    { "name": "Language Constants", "scope": ["constant.language", "variable.language", "support.constant"], "settings": { "foreground": "#B58900" } },
    { "name": "Variables", "scope": ["variable", "support.variable"], "settings": { "foreground": "#93A1A1" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.parameter"], "settings": { "fontStyle": "italic", "foreground": "#84949C" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "fontStyle": "bold", "foreground": "#4E9BD6" } },
    { "name": "Classes", "scope": ["entity.name.type", "entity.name.namespace", "entity.name.scope-resolution", "entity.other.inherited-class", "support.class"], "settings": { "fontStyle": "bold", "foreground": "#948ED2" } },
    { "name": "Sections", "scope": "entity.name.section", "settings": { "fontStyle": "bold", "foreground": "#DD7239" } },
    { "name": "Numbers, Characters", "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#E36A9E" } },
    { "name": "Strings", "scope": "string", "settings": { "foreground": "#2AA198" } },
    { "name": "Strings: Escape Sequences", "scope": "constant.character.escape", "settings": { "foreground": "#E36A9E" } },
    { "name": "Strings: Regular Expressions", "scope": "string.regexp", "settings": { "foreground": "#2AA198" } },
    { "name": "Punctuation", "scope": "punctuation", "settings": { "foreground": "#93A1A1" } },
    { "name": "HTML: Doctype Declaration", "scope": ["meta.tag.sgml.doctype", "meta.tag.sgml.doctype string", "meta.tag.sgml.doctype entity.name.tag"], "settings": { "foreground": "#84949C" } },
    { "name": "HTML: Tags", "scope": ["meta.tag", "punctuation.definition.tag.html", "punctuation.definition.tag.begin.html", "punctuation.definition.tag.end.html"], "settings": { "foreground": "#4E9BD6" } },
    { "name": "HTML: Tag Names", "scope": "entity.name.tag", "settings": { "foreground": "#4E9BD6" } },
    { "name": "HTML: Attribute Names", "scope": ["meta.tag entity.other.attribute-name", "entity.other.attribute-name.html"], "settings": { "fontStyle": "italic", "foreground": "#8EA42B" } },
    { "name": "HTML: Entities", "scope": ["constant.character.entity", "punctuation.definition.entity"], "settings": { "foreground": "#E36A9E" } },
    { "name": "CSS: Selectors", "scope": ["meta.selector", "meta.selector entity", "meta.selector entity punctuation", "entity.name.tag.css"], "settings": { "foreground": "#948ED2" } },
    { "name": "CSS: Property Names", "scope": ["meta.property-name", "support.type.property-name"], "settings": { "foreground": "#4E9BD6" } },
    { "name": "CSS: Property Values", "scope": ["meta.property-value", "meta.property-value constant.other", "support.constant.property-value"], "settings": { "foreground": "#8EA42B" } },
    { "name": "CSS: Important Keyword", "scope": "keyword.other.important", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Changed", "scope": "markup.changed", "settings": { "foreground": "#DD7239" } },
    { "name": "Markup: Deletion", "scope": "markup.deleted", "settings": { "foreground": "#E9765C" } },
    { "name": "Markup: Emphasis", "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "name": "Markup: Error", "scope": "markup.error", "settings": { "foreground": "#E9765C" } },
    { "name": "Markup: Insertion", "scope": "markup.inserted", "settings": { "foreground": "#8EA42B" } },
    { "name": "Markup: Link", "scope": "meta.link", "settings": { "foreground": "#4E9BD6" } },
    { "name": "Markup: Heading", "scope": "markup.heading", "settings": { "fontStyle": "bold", "foreground": "#DD7239" } },
    { "name": "Markup: Strong", "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Traceback", "scope": "markup.traceback", "settings": { "foreground": "#E9765C" } },
    { "name": "Markup: Underline", "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": "markup.quote", "settings": { "foreground": "#948ED2" } },
    { "name": "Markup Lists", "scope": "markup.list", "settings": { "foreground": "#E36A9E" } },
    { "name": "Markup Styling", "scope": ["markup.bold", "markup.italic"], "settings": { "foreground": "#2AA198" } },
    { "name": "Markup Inline", "scope": "markup.inline.raw", "settings": { "fontStyle": "", "foreground": "#2AA198" } },
    { "name": "Extra: Diff Range", "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"], "settings": { "foreground": "#948ED2" } },
    { "name": "Extra: Diff From", "scope": ["meta.diff.header.from-file", "punctuation.definition.from-file.diff"], "settings": { "foreground": "#4E9BD6" } },
    { "name": "Extra: Diff To", "scope": ["meta.diff.header.to-file", "punctuation.definition.to-file.diff"], "settings": { "foreground": "#4E9BD6" } },
    { "name": "diff: deleted", "scope": "markup.deleted.diff", "settings": { "foreground": "#E9765C" } },
    { "name": "diff: changed", "scope": "markup.changed.diff", "settings": { "foreground": "#DD7239" } },
    { "name": "diff: inserted", "scope": "markup.inserted.diff", "settings": { "foreground": "#8EA42B" } }
  ],
  "colors": {
    "editor.background": "#002B36",
    "editor.foreground": "#93A1A1",
    "editorLineNumber.foreground": "#839496",
    "editorLineNumber.activeForeground": "#4E9BD6",
    "editorWhitespace.foreground": "#839496",
    "editor.lineHighlightBackground": "#073642",
    "editor.selectionBackground": "#073642",
    "editorCursor.foreground": "#93A1A1",
    "editor.highlightedDelimiters.foreground": "#2AA198",
    "editor.highlightedDelimiters.background": "#0A3A47",
    "editor.lineNumber.divider": "#0A3A47",
    "editor.findMatchBackground": "#14424E",
    "editor.wordHighlightBackground": "#14424E",
    "editorScrollbar.thumb": "#405B63",
    "editorScrollbar.thumbPressed": "#54707A",
    "editorScrollbar.track": "#06313D",
    "minimap.background": "#002630",
    "minimap.viewport": "#14424E",
    "minimap.viewportBorder": "#1C4C58"
  },
  "semanticHighlighting": true
}
