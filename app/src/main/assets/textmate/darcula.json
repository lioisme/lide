            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "",
            "scope": "meta.embedded.block.css",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Markup Bullet",
            "scope": "punctuation.definition.list.begin.markup",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Tag",
            "scope": "entity.name.tag,entity.name.tag.script,entity.name.tag.style,entity.name.tag.documentation,entity.name.tag.block,entity.name.tag.inline",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Attribute Name",
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Attribute Value",
            "scope": "string.quoted,meta.attribute-with-value",
            "settings": {
                "foreground": "#6A8759"
            }
        },
        {
            "name": "Punctuation",
