            }
        },
        {
            "name": "Deleted",
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Inserted",
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#6A8759"
            }
        },
        {
            "name": "Changed",
            "scope": "markup.changed",
            "settings": {
                "foreground": "#BBB529"
            }
        }
