{
    "name": "darcula",
    "settings": [{
        "settings": {
            "background": "#242424",
            "foreground": "#cccccc",
            "lineHighlight": "#2B2B2B",
            "selection": "#214283",
            "highlightedDelimitersForeground": "#57f6c0"
        }
    },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "foreground": "#707070"
            }
        },
        {
            "name": "Operator Keywords",
            "scope": "keyword.operator,keyword.operator.logical,keyword.operator.relational,keyword.operator.assignment,keyword.operator.comparison,keyword.operator.ternary,keyword.operator.arithmetic,keyword.operator.spread",
            "settings": {
                "foreground": "#CCCCCC"
            }
        },
        {
            "name": "Strings",
            "scope": "string,string.character.escape,string.template.quoted,string.template.quoted.punctuation,string.template.quoted.punctuation.single,string.template.quoted.punctuation.double,string.type.declaration.annotation,string.template.quoted.punctuation.tag",
            "settings": {
                "foreground": "#6A8759"
            }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#6897BB"
            }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "",
            "scope": "entity.other.attribute-name,entity.other.attribute-name.placeholder",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Keywords",
            "scope": "keyword,storage,keyword.control.directive,keyword.control.directive.punctuation",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Storage Types",
            "scope": "storage.type,storage.type.function",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Types",
            "scope": "support.type,meta.type.annotation",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function,entity.name.function.forward-declaration,entity.name.function.definition,entity.name.function.definition.special.override,entity.name.method,entity.name.method.definition,entity.name.method.definition.special.override,entity.name.static.method,entity.name.static.method.definition,entity.name.static.method.definition.special.override,meta.method.definition,entity.name.function.special,entity.name.function.special.override",
            "settings": {
