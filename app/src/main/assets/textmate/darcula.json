            }
        },
        {
            "name": "Builtins",
            "scope": "support.function, support.function.magic, support.method, support.method.magic, support.function.builtin, support.function.any-method",
            "settings": {
                "foreground": "#FFC66D"
            }
        },
        {
            "name": "Variables",
            "scope": "variable.language, variable.parameter",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Constant",
            "scope": "constant, constant.language, constant.character, constant.other",
            "settings": {
                "foreground": "#6897BB"
            }
        },
        {
            "name": "",
            "scope": "meta.parameter",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Class name",
            "scope": "entity.name.type,entity.name.class,entity.other.inherited-class,entity.name.namespace,entity.name.scope-resolution",
            "settings": {
                "foreground": "#FFC66D"
            }
