            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation.section,punctuation.section.embedded,punctuation.section.block,punctuation.section.array,punctuation.section.group,punctuation.section.generic,punctuation.section.scope,punctuation.section.parameters,punctuation.section.arguments,punctuation.section.braces,punctuation.section.brackets,punctuation.section.parens,punctuation.section.sequence,punctuation.section.mapping,punctuation.section.key-value,punctuation.separator,punctuation.separator.continuation,punctuation.separator.key-value,punctuation.separator.value,punctuation.terminator",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Shebang",
            "scope": "comment.line.shebang",
            "settings": {
                "foreground": "#707070"
            }
        },
        {
            "name": "Annotation",
            "scope": "storage.type.annotation,storage.type.annotation.builtin,storage.type.annotation.unknown",
            "settings": {
                "foreground": "#BBB529"
            }
        },
        {
            "name": "Injection Punctuation",
            "scope": "meta.embedded,punctuation.section.embedded",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "settings": {
                "foreground": "#6897BB"
            }
        },
        {
            "name": "Markup List",
            "scope": "markup.list",
            "settings": {
                "foreground": "#CC7832"
            }
        },
        {
            "name": "Markup Styling",
            "scope": "markup.bold,markup.italic",
            "settings": {
                "foreground": "#A9B7C6"
            }
        },
        {
            "name": "Markup Heading",
