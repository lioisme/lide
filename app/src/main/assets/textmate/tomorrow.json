{
  "name": "Tomorrow Dual (Light)",
  "tokenColors": [
    { "settings": { "foreground": "#4D4D4C" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "fontStyle": "italic", "foreground": "#6E6F6C" } },
    { "name": "Comments: Preprocessor", "scope": "comment.block.preprocessor", "settings": { "fontStyle": "", "foreground": "#6E6F6C" } },
    { "name": "Comments: Documentation", "scope": ["comment.documentation", "comment.block.documentation"], "settings": { "foreground": "#676865" } },
    { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "#A62B2B" } },
    { "name": "Invalid - Illegal", "scope": "invalid.illegal", "settings": { "foreground": "#8E1F1F" } },
    { "name": "Operators", "scope": "keyword.operator", "settings": { "foreground": "#4D4D4C" } },
    { "name": "Keywords", "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#8959A8" } },
    { "name": "Types", "scope": ["storage.type", "support.type"], "settings": { "foreground": "#3E66A0" } },
    { "name": "Language Constants", "scope": ["constant.language", "variable.language", "support.constant"], "settings": { "foreground": "#C82829" } },
    { "name": "Variables", "scope": ["variable", "support.variable"], "settings": { "foreground": "#C82829" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.parameter"], "settings": { "fontStyle": "italic", "foreground": "#6E6F6C" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "fontStyle": "bold", "foreground": "#4271AE" } },
    { "name": "Classes", "scope": ["entity.name.type", "entity.name.namespace", "entity.name.scope-resolution", "entity.other.inherited-class", "support.class"], "settings": { "fontStyle": "bold", "foreground": "#966800" } },
    { "name": "Sections", "scope": "entity.name.section", "settings": { "fontStyle": "bold", "foreground": "#A95500" } },
    { "name": "Numbers, Characters", "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#A95500" } },
    { "name": "Strings", "scope": "string", "settings": { "foreground": "#5E7D00" } },
    { "name": "Strings: Escape Sequences", "scope": "constant.character.escape", "settings": { "foreground": "#A95500" } },
    { "name": "Strings: Regular Expressions", "scope": "string.regexp", "settings": { "foreground": "#5E7D00" } },
    { "name": "Punctuation", "scope": "punctuation", "settings": { "foreground": "#4D4D4C" } },
    { "name": "HTML: Doctype Declaration", "scope": ["meta.tag.sgml.doctype", "meta.tag.sgml.doctype string", "meta.tag.sgml.doctype entity.name.tag"], "settings": { "foreground": "#6E6F6C" } },
    { "name": "HTML: Tags", "scope": ["meta.tag", "punctuation.definition.tag.html", "punctuation.definition.tag.begin.html", "punctuation.definition.tag.end.html"], "settings": { "foreground": "#C82829" } },
    { "name": "HTML: Tag Names", "scope": "entity.name.tag", "settings": { "foreground": "#C82829" } },
    { "name": "HTML: Attribute Names", "scope": ["meta.tag entity.other.attribute-name", "entity.other.attribute-name.html"], "settings": { "fontStyle": "italic", "foreground": "#8959A8" } },
    { "name": "HTML: Entities", "scope": ["constant.character.entity", "punctuation.definition.entity"], "settings": { "foreground": "#A95500" } },
    { "name": "CSS: Selectors", "scope": ["meta.selector", "meta.selector entity", "meta.selector entity punctuation", "entity.name.tag.css"], "settings": { "foreground": "#966800" } },
    { "name": "CSS: Property Names", "scope": ["meta.property-name", "support.type.property-name"], "settings": { "foreground": "#3E66A0" } },
    { "name": "CSS: Property Values", "scope": ["meta.property-value", "meta.property-value constant.other", "support.constant.property-value"], "settings": { "foreground": "#5E7D00" } },
    { "name": "CSS: Important Keyword", "scope": "keyword.other.important", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Changed", "scope": "markup.changed", "settings": { "foreground": "#966800" } },
    { "name": "Markup: Deletion", "scope": "markup.deleted", "settings": { "foreground": "#C82829" } },
    { "name": "Markup: Emphasis", "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "name": "Markup: Error", "scope": "markup.error", "settings": { "foreground": "#C82829" } },
    { "name": "Markup: Insertion", "scope": "markup.inserted", "settings": { "foreground": "#5E7D00" } },
    { "name": "Markup: Link", "scope": "meta.link", "settings": { "foreground": "#4271AE" } },
    { "name": "Markup: Heading", "scope": "markup.heading", "settings": { "fontStyle": "bold", "foreground": "#8959A8" } },
    { "name": "Markup: Strong", "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Traceback", "scope": "markup.traceback", "settings": { "foreground": "#C82829" } },
    { "name": "Markup: Underline", "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": "markup.quote", "settings": { "foreground": "#8959A8" } },
    { "name": "Markup Lists", "scope": "markup.list", "settings": { "foreground": "#C82829" } },
    { "name": "Markup Styling", "scope": ["markup.bold", "markup.italic"], "settings": { "foreground": "#5E7D00" } },
    { "name": "Markup Inline", "scope": "markup.inline.raw", "settings": { "fontStyle": "", "foreground": "#A95500" } },
    { "name": "Extra: Diff Range", "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"], "settings": { "foreground": "#8959A8" } },
    { "name": "Extra: Diff From", "scope": ["meta.diff.header.from-file", "punctuation.definition.from-file.diff"], "settings": { "foreground": "#4271AE" } },
    { "name": "Extra: Diff To", "scope": ["meta.diff.header.to-file", "punctuation.definition.to-file.diff"], "settings": { "foreground": "#4271AE" } },
    { "name": "diff: deleted", "scope": "markup.deleted.diff", "settings": { "foreground": "#C82829" } },
    { "name": "diff: changed", "scope": "markup.changed.diff", "settings": { "foreground": "#966800" } },
    { "name": "diff: inserted", "scope": "markup.inserted.diff", "settings": { "foreground": "#5E7D00" } }
  ],
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#4D4D4C",
    "editorLineNumber.foreground": "#737373",
    "editorLineNumber.activeForeground": "#4271AE",
    "editorWhitespace.foreground": "#737373",
    "editor.lineHighlightBackground": "#EFEFEF",
    "editor.selectionBackground": "#D6D6D6",
    "editorCursor.foreground": "#4D4D4C",
    "editor.highlightedDelimiters.foreground": "#4271AE",
    "editor.highlightedDelimiters.background": "#E0E0E0",
    "editor.lineNumber.divider": "#E0E0E0",
    "editor.findMatchBackground": "#F7D9C9",
    "editor.wordHighlightBackground": "#FCE8C9",
    "editorScrollbar.thumb": "#C0C0C0",
    "editorScrollbar.thumbPressed": "#A0A0A0",
    "editorScrollbar.track": "#F0F0F0",
    "minimap.background": "#FAFAFA",
    "minimap.viewport": "#D6D6D6",
    "minimap.viewportBorder": "#C0C0C0"
  },
  "semanticHighlighting": true
}
