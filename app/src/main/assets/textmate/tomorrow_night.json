{
  "name": "Tomorrow Dual (Night)",
  "tokenColors": [
    { "settings": { "foreground": "#C5C8C6" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "fontStyle": "italic", "foreground": "#969896" } },
    { "name": "Comments: Preprocessor", "scope": "comment.block.preprocessor", "settings": { "fontStyle": "", "foreground": "#969896" } },
    { "name": "Comments: Documentation", "scope": ["comment.documentation", "comment.block.documentation"], "settings": { "foreground": "#9D9F9C" } },
    { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "#D27575" } },
    { "name": "Invalid - Illegal", "scope": "invalid.illegal", "settings": { "foreground": "#E08A8A" } },
    { "name": "Operators", "scope": "keyword.operator", "settings": { "foreground": "#C5C8C6" } },
    { "name": "Keywords", "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#B294BB" } },
    { "name": "Types", "scope": ["storage.type", "support.type"], "settings": { "foreground": "#81A2BE" } },
    { "name": "Language Constants", "scope": ["constant.language", "variable.language", "support.constant"], "settings": { "foreground": "#D27575" } },
    { "name": "Variables", "scope": ["variable", "support.variable"], "settings": { "foreground": "#D27575" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.parameter"], "settings": { "fontStyle": "italic", "foreground": "#969896" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "fontStyle": "bold", "foreground": "#81A2BE" } },
    { "name": "Classes", "scope": ["entity.name.type", "entity.name.namespace", "entity.name.scope-resolution", "entity.other.inherited-class", "support.class"], "settings": { "fontStyle": "bold", "foreground": "#F0C674" } },
    { "name": "Sections", "scope": "entity.name.section", "settings": { "fontStyle": "bold", "foreground": "#DE935F" } },
    { "name": "Numbers, Characters", "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#DE935F" } },
    { "name": "Strings", "scope": "string", "settings": { "foreground": "#B5BD68" } },
    { "name": "Strings: Escape Sequences", "scope": "constant.character.escape", "settings": { "foreground": "#DE935F" } },
    { "name": "Strings: Regular Expressions", "scope": "string.regexp", "settings": { "foreground": "#B5BD68" } },
    { "name": "Punctuation", "scope": "punctuation", "settings": { "foreground": "#C5C8C6" } },
    { "name": "HTML: Doctype Declaration", "scope": ["meta.tag.sgml.doctype", "meta.tag.sgml.doctype string", "meta.tag.sgml.doctype entity.name.tag"], "settings": { "foreground": "#969896" } },
    { "name": "HTML: Tags", "scope": ["meta.tag", "punctuation.definition.tag.html", "punctuation.definition.tag.begin.html", "punctuation.definition.tag.end.html"], "settings": { "foreground": "#D27575" } },
    { "name": "HTML: Tag Names", "scope": "entity.name.tag", "settings": { "foreground": "#D27575" } },
    { "name": "HTML: Attribute Names", "scope": ["meta.tag entity.other.attribute-name", "entity.other.attribute-name.html"], "settings": { "fontStyle": "italic", "foreground": "#B294BB" } },
    { "name": "HTML: Entities", "scope": ["constant.character.entity", "punctuation.definition.entity"], "settings": { "foreground": "#DE935F" } },
    { "name": "CSS: Selectors", "scope": ["meta.selector", "meta.selector entity", "meta.selector entity punctuation", "entity.name.tag.css"], "settings": { "foreground": "#F0C674" } },
    { "name": "CSS: Property Names", "scope": ["meta.property-name", "support.type.property-name"], "settings": { "foreground": "#81A2BE" } },
    { "name": "CSS: Property Values", "scope": ["meta.property-value", "meta.property-value constant.other", "support.constant.property-value"], "settings": { "foreground": "#B5BD68" } },
    { "name": "CSS: Important Keyword", "scope": "keyword.other.important", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Changed", "scope": "markup.changed", "settings": { "foreground": "#F0C674" } },
    { "name": "Markup: Deletion", "scope": "markup.deleted", "settings": { "foreground": "#D27575" } },
    { "name": "Markup: Emphasis", "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "name": "Markup: Error", "scope": "markup.error", "settings": { "foreground": "#D27575" } },
    { "name": "Markup: Insertion", "scope": "markup.inserted", "settings": { "foreground": "#B5BD68" } },
    { "name": "Markup: Link", "scope": "meta.link", "settings": { "foreground": "#81A2BE" } },
    { "name": "Markup: Heading", "scope": "markup.heading", "settings": { "fontStyle": "bold", "foreground": "#F0C674" } },
    { "name": "Markup: Strong", "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "name": "Markup: Traceback", "scope": "markup.traceback", "settings": { "foreground": "#D27575" } },
    { "name": "Markup: Underline", "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
    { "name": "Markup Quote", "scope": "markup.quote", "settings": { "foreground": "#B294BB" } },
    { "name": "Markup Lists", "scope": "markup.list", "settings": { "foreground": "#D27575" } },
    { "name": "Markup Styling", "scope": ["markup.bold", "markup.italic"], "settings": { "foreground": "#B5BD68" } },
    { "name": "Markup Inline", "scope": "markup.inline.raw", "settings": { "fontStyle": "", "foreground": "#DE935F" } },
    { "name": "Extra: Diff Range", "scope": ["meta.diff.range", "meta.diff.index", "meta.separator"], "settings": { "foreground": "#B294BB" } },
    { "name": "Extra: Diff From", "scope": ["meta.diff.header.from-file", "punctuation.definition.from-file.diff"], "settings": { "foreground": "#81A2BE" } },
    { "name": "Extra: Diff To", "scope": ["meta.diff.header.to-file", "punctuation.definition.to-file.diff"], "settings": { "foreground": "#81A2BE" } },
    { "name": "diff: deleted", "scope": "markup.deleted.diff", "settings": { "foreground": "#D27575" } },
    { "name": "diff: changed", "scope": "markup.changed.diff", "settings": { "foreground": "#F0C674" } },
    { "name": "diff: inserted", "scope": "markup.inserted.diff", "settings": { "foreground": "#B5BD68" } }
  ],
  "colors": {
    "editor.background": "#1D1F21",
    "editor.foreground": "#C5C8C6",
    "editorLineNumber.foreground": "#888B90",
    "editorLineNumber.activeForeground": "#81A2BE",
    "editorWhitespace.foreground": "#888B90",
    "editor.lineHighlightBackground": "#282A2E",
    "editor.selectionBackground": "#373B41",
    "editorCursor.foreground": "#C5C8C6",
    "editor.highlightedDelimiters.foreground": "#81A2BE",
    "editor.highlightedDelimiters.background": "#2B2E33",
    "editor.lineNumber.divider": "#2B2D31",
    "editor.findMatchBackground": "#4A3A24",
    "editor.wordHighlightBackground": "#3A3A22",
    "editorScrollbar.thumb": "#4E5157",
    "editorScrollbar.thumbPressed": "#60646B",
    "editorScrollbar.track": "#222428",
    "minimap.background": "#1A1C1E",
    "minimap.viewport": "#373B41",
    "minimap.viewportBorder": "#4E5157"
  },
  "semanticHighlighting": true
}
