# Gradle / Android build output
.gradle/
build/
app/build/

# 源码包目录名为 build（打包器模块），需要保留跟踪
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iml
.DS_Store

# Local configuration
local.properties

# Logs and crash dumps
*.log
hs_err_pid*.log
replay_pid*.log

# Build error captures
build-java-errors*.txt

# Stray artifacts
classes.jar

# Built-in examples .alp are generated at build time from build-scripts/examples-src/
# (Gradle task :app:generateExamples); never commit the generated archives.
app/src/main/assets/examples/*.alp

# Engine native libs: built solely from vendored C sources in build-scripts/jni/
# via scripts/rebuild_engine.ps1|.sh (see CI build jobs); NEVER commit binaries.
app/src/main/jniLibs/

# Downloaded reference projects (never committed)
docs/reference/
