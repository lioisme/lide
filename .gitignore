# Gradle / Android build output
.gradle/
build/
app/build/

# Kotlin daemon / sessions cache
.kotlin/

# 源码包目录名为 build（打包器模块），需要保留跟踪
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iml
.DS_Store

# Local configuration
local.properties

# Logs and crash dumps
*.log
hs_err_pid*.log
replay_pid*.log

# Build error captures
build-java-errors*.txt

# Stray artifacts
classes.jar

# Built-in examples .alp are generated at build time from scripts/examples-src/
# (Gradle task :app:generateExamples); never commit the generated archives.
app/src/main/assets/examples/*.alp

# Engine native libs: built from source by AGP externalNativeBuild (app/src/main/cpp/);
# AGP outputs to app/build/ which is already ignored above; NEVER commit binaries.
# Downloaded reference projects (never committed)
reference/

# Legacy guards: block re-creation of superseded locations
参考资料/
docs/reference/

# Shadow 插件机制废弃守卫（2026-08-07 D-19：取消插件平台，androlua 仅作上游基线集成；
# 以下位置如有残留/重建一律不跟踪，防误入库）
third_party/shadow/
androlua-loader/
androlua-plugin/
hello-loader/
hello-plugin/
hello-runtime/
plugin-sdk/
app/src/main/assets/lide-plugins/
